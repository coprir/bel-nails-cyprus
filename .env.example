# Copy this to .env.development.local for local development
# (`vercel env pull .env.development.local` does this for Production/Preview
# values once they're set in your Vercel project's dashboard).
# NEVER commit a real .env* file — .gitignore already excludes them.

# --- Database (auto-filled if you connect Vercel Postgres to this project
#     from the Storage tab — you won't normally set this by hand) ----------
POSTGRES_URL=

# --- Image storage (auto-filled if you connect Vercel Blob to this project
#     from the Storage tab) -------------------------------------------------
BLOB_READ_WRITE_TOKEN=

# --- Master Admin bootstrap (used ONLY by `npm run init-master`, a local
#     one-time script — see scripts/init-master.mjs). Replace both values
#     with your own private email and a strong, unique password before
#     running the script. Never use these placeholder values for real. -----
MASTER_ADMIN_EMAIL=YOUR_PRIVATE_ADMIN_EMAIL
MASTER_ADMIN_PASSWORD=GENERATE_A_STRONG_PASSWORD
MASTER_ADMIN_NAME=Master Admin
